# MongoDB connection string (MongoDB Atlas or local)
# Example (local): mongodb://127.0.0.1:27017/landing_page
# Example (Atlas): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/landing_page?retryWrites=true&w=majority
MONGODB_URI=

# Server port
PORT=3000

# JWT secret used for auth tokens (change in production)
JWT_SECRET=change-this-secret
